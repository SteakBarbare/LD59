event_inherited()
size = random_range(0.3, 0.8);
image_xscale = size;
image_yscale = size;
image_angle = random(360);
image_alpha = 0;

emberAlpha = 0;
emberRotation = 45;

rotationVar = 0;

hsp = round(random_range(-2.8, 2.8));
vsp = round(random_range(-2.8, 2.8));
baseHsp = hsp;
isDisappearing = false;
disappearingChance = 1100;

isCorrupted = false;