// Script assets have changed for v2.3.0 see
// https://help.yoyogames.com/hc/en-us/articles/360005277377 for more information
function srcSpawnInRoomTemporaryFix(){
	var ro = argument[0];
	
	switch(ro)
	{
		case TutorialMapIntro: 
			x = 2865;
			y = 911;
			break;
			
		case SalleSacrifice :
			x = 866;
			y = 597
			break;
		
		case TutorialMap :
			x = 369;
			y = 226;
			break;
			
		case roomLightDemoStart:
			x = 220;
			y = 790;
			break;
			
		case roomLightDemoBottom:
			x = 1911;
			y = 574;
			break;
			
		case roomLightDemoCavern:
			x = 1100;
			y = 435;
			break;
			
		case roomLightDemoBoss:
			x = 850;
			y = 1760;
			break;
			
		case Nodens : 
			x = 1596;
			y = 3419;
			break;
			
		case Battlefield : 
			x = 2654;
			y = 5661;
			break;
	}

}